{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kontrak transaksi source lokal dan Studio — rancangan v1",
  "description": "Metadata dan bukti; controller/bridge belum diimplementasikan. Hash/path yang cocok harus diverifikasi terhadap file/editor aktual, bukan dipercaya dari JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "mode", "state", "baseline", "targets", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["offline_candidate", "studio_bridge"] },
    "state": { "enum": ["draft", "prepared", "candidate_verified", "applied", "tested", "saved_verified", "conflict", "failed"] },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeFile", "sha256", "backupFile"],
      "properties": {
        "placeFile": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "backupFile": { "type": "string", "minLength": 1 }
      }
    },
    "studioSessionId": { "type": "string", "minLength": 1 },
    "candidateFile": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["instancePath", "className", "sourceFile", "baseSourceSha256", "localSourceSha256", "dependencies"],
        "properties": {
          "instancePath": { "$ref": "#/$defs/path" },
          "className": { "enum": ["LocalScript", "Script", "ModuleScript"] },
          "sourceFile": { "type": "string", "minLength": 1 },
          "baseSourceSha256": { "$ref": "#/$defs/hash" },
          "localSourceSha256": { "$ref": "#/$defs/hash" },
          "studioSourceSha256": { "$ref": "#/$defs/hash" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instancePath", "className"],
              "properties": {
                "instancePath": { "$ref": "#/$defs/path" },
                "className": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["backupVerified", "dependenciesVerified", "luauCheck", "binaryCheck", "editorReadback", "play", "savedReadback"],
      "properties": {
        "backupVerified": { "type": "boolean" },
        "dependenciesVerified": { "type": "boolean" },
        "luauCheck": { "$ref": "#/$defs/check" },
        "binaryCheck": { "$ref": "#/$defs/check" },
        "editorReadback": { "$ref": "#/$defs/check" },
        "play": { "$ref": "#/$defs/check" },
        "savedReadback": { "$ref": "#/$defs/check" },
        "savedFileSha256": { "$ref": "#/$defs/hash" },
        "reportFile": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["prepared", "candidate_verified", "applied", "tested", "saved_verified"] } } },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "backupVerified": { "const": true },
              "dependenciesVerified": { "const": true },
              "luauCheck": { "const": "passed" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["tested", "saved_verified"] } } },
      "then": { "properties": { "evidence": { "properties": { "play": { "const": "passed" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "studio_bridge" } } },
      "then": {
        "required": ["studioSessionId"],
        "properties": { "state": { "enum": ["draft", "prepared", "applied", "tested", "saved_verified", "conflict", "failed"] } },
        "allOf": [
          {
            "if": { "properties": { "state": { "enum": ["applied", "tested", "saved_verified"] } } },
            "then": { "properties": { "evidence": { "properties": { "editorReadback": { "const": "passed" } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "mode": { "const": "offline_candidate" } } },
      "then": {
        "required": ["candidateFile"],
        "properties": { "state": { "enum": ["draft", "prepared", "candidate_verified", "tested", "saved_verified", "conflict", "failed"] } },
        "allOf": [
          {
            "if": { "properties": { "state": { "enum": ["candidate_verified", "tested", "saved_verified"] } } },
            "then": { "properties": { "evidence": { "properties": { "binaryCheck": { "const": "passed" } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "state": { "const": "saved_verified" } } },
      "then": {
        "properties": {
          "evidence": {
            "required": ["savedFileSha256", "reportFile"],
            "properties": {
              "backupVerified": { "const": true },
              "dependenciesVerified": { "const": true },
              "play": { "const": "passed" },
              "savedReadback": { "const": "passed" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "check": { "enum": ["not_run", "passed", "failed", "not_applicable"] }
  }
}
